#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -File tools/pre-commit.ps1
elif command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/pre-commit.ps1
else
    echo "Kvas pre-commit gate requires PowerShell 7 (pwsh) or Windows PowerShell." >&2
    echo "Install/configure PowerShell, then run: ./tools/pre-commit.ps1" >&2
    exit 1
fi
